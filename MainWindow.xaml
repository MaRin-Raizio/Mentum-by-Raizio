<Window
    x:Class="MentumLauncher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Mentum Launcher 2.1.0"
    Width="860"
    Height="660"
    MinHeight="620"
    AllowsTransparency="False"
    Background="#0F1117"
    FontFamily="Segoe UI"
    ResizeMode="CanMinimize"
    WindowStyle="None">

    <Window.Resources>

        <Style x:Key="BaseBtn" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.80" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.60" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="BtnGreen"
            BasedOn="{StaticResource BaseBtn}"
            TargetType="Button">
            <Setter Property="Background" Value="#0D2318" />
            <Setter Property="BorderBrush" Value="#166534" />
            <Setter Property="Foreground" Value="#86EFAC" />
        </Style>
        <Style
            x:Key="BtnBlue"
            BasedOn="{StaticResource BaseBtn}"
            TargetType="Button">
            <Setter Property="Background" Value="#0D1929" />
            <Setter Property="BorderBrush" Value="#1E3A5F" />
            <Setter Property="Foreground" Value="#93C5FD" />
        </Style>
        <Style
            x:Key="BtnAmber"
            BasedOn="{StaticResource BaseBtn}"
            TargetType="Button">
            <Setter Property="Background" Value="#1C1408" />
            <Setter Property="BorderBrush" Value="#78350F" />
            <Setter Property="Foreground" Value="#FCD34D" />
        </Style>
        <Style
            x:Key="BtnFeatured"
            BasedOn="{StaticResource BaseBtn}"
            TargetType="Button">
            <Setter Property="Background" Value="#1E1530" />
            <Setter Property="BorderBrush" Value="#7C3AED" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Foreground" Value="#C4B5FD" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Height" Value="42" />
        </Style>
        <Style
            x:Key="BtnNeutral"
            BasedOn="{StaticResource BaseBtn}"
            TargetType="Button">
            <Setter Property="Background" Value="#181B28" />
            <Setter Property="BorderBrush" Value="#252836" />
            <Setter Property="Foreground" Value="#9CA3AF" />
        </Style>
        <Style
            x:Key="BtnRed"
            BasedOn="{StaticResource BaseBtn}"
            TargetType="Button">
            <Setter Property="Background" Value="#200F0F" />
            <Setter Property="BorderBrush" Value="#7F1D1D" />
            <Setter Property="Foreground" Value="#FCA5A5" />
        </Style>

        <!--  Botón de titlebar (minimizar / cerrar)  -->
        <Style x:Key="TitleBtn" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#4ADE80" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#16301E" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.60" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="TitleBtnClose"
            BasedOn="{StaticResource TitleBtn}"
            TargetType="Button">
            <Setter Property="Foreground" Value="#FCA5A5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#200F0F" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.60" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#4B5563" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

    </Window.Resources>

    <Border
        BorderBrush="#166534"
        BorderThickness="1"
        CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  ══ BARRA DE TÍTULO (opción 2: fondo verde oscuro) ══  -->
            <Grid
                Grid.Row="0"
                Background="#0D2318"
                MouseDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Logo grande + nombre  -->
                <StackPanel
                    Grid.Column="0"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Border
                        Width="36"
                        Height="36"
                        Margin="0,0,12,0"
                        Background="#1E1530"
                        BorderBrush="#7C3AED"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Button
                            Width="36"
                            Height="36"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="Logo_Click"
                            Cursor="Hand"
                            ToolTip="Ver en GitHub">
                            <Image
                                Width="24"
                                Height="24"
                                Source="pack://application:,,,/Resources/logo.png" />
                        </Button>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#86EFAC"
                            LineHeight="16"
                            Text="Mentum Launcher" />
                        <TextBlock
                            FontFamily="Consolas"
                            FontSize="10"
                            Foreground="#4B5563"
                            LineHeight="14"
                            Text="stable release · v2.1.0" />
                    </StackPanel>
                </StackPanel>

                <!--  Botones minimizar / cerrar  -->
                <StackPanel
                    Grid.Column="2"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Click="BtnMinimize_Click"
                        Content="—"
                        FontFamily="Consolas"
                        Style="{StaticResource TitleBtn}" />
                    <Button
                        Click="BtnCerrar_Click"
                        Content="✕"
                        FontFamily="Consolas"
                        Style="{StaticResource TitleBtnClose}" />
                </StackPanel>
            </Grid>

            <Rectangle
                Grid.Row="1"
                Height="1"
                Fill="#166534" />

            <!--  ══ CONTENIDO PRINCIPAL ══  -->
            <Grid
                Grid.Row="2"
                Margin="22,14,22,14"
                Background="#0F1117">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Reparación  -->
                <TextBlock
                    Grid.Row="0"
                    Style="{StaticResource SectionLabel}"
                    Text="REPARACIÓN DEL SISTEMA" />
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button
                        x:Name="BtnQuickRepair"
                        Grid.Row="0"
                        Grid.Column="0"
                        Click="BtnQuickRepair_Click"
                        Content="⚡  Reparación rápida"
                        Style="{StaticResource BtnGreen}" />
                    <Button
                        x:Name="BtnDeepScan"
                        Grid.Row="0"
                        Grid.Column="2"
                        Click="BtnDeepScan_Click"
                        Content="🔍  Escaneo profundo DISM"
                        Style="{StaticResource BtnGreen}" />
                    <Button
                        x:Name="BtnRestoreImage"
                        Grid.Row="2"
                        Grid.Column="0"
                        Click="BtnRestoreImage_Click"
                        Content="🛡  Restaurar imagen Windows"
                        Style="{StaticResource BtnGreen}" />
                    <Button
                        x:Name="BtnResetNetwork"
                        Grid.Row="2"
                        Grid.Column="2"
                        Click="BtnResetNetwork_Click"
                        Content="🌐  Reparar configuración de red"
                        Style="{StaticResource BtnGreen}" />
                </Grid>

                <!--  Disco  -->
                <TextBlock
                    Grid.Row="3"
                    Style="{StaticResource SectionLabel}"
                    Text="DISCO Y RENDIMIENTO" />
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button
                        x:Name="BtnDiskCheck"
                        Grid.Row="0"
                        Grid.Column="0"
                        Click="BtnDiskCheck_Click"
                        Content="💾  Revisar disco (CHKDSK)"
                        Style="{StaticResource BtnBlue}" />
                    <Button
                        x:Name="BtnDiskOptimization"
                        Grid.Row="0"
                        Grid.Column="2"
                        Click="BtnDiskOptimization_Click"
                        Content="🚀  Optimizar disco"
                        Style="{StaticResource BtnBlue}" />
                    <Button
                        x:Name="BtnTempCleanup"
                        Grid.Row="2"
                        Grid.Column="0"
                        Click="BtnTempCleanup_Click"
                        Content="🗑  Limpiar archivos temporales"
                        Style="{StaticResource BtnAmber}" />
                    <Button
                        x:Name="BtnSystemInfo"
                        Grid.Row="2"
                        Grid.Column="2"
                        Click="BtnSystemInfo_Click"
                        Content="ℹ  Información del sistema"
                        Style="{StaticResource BtnNeutral}" />
                </Grid>

                <!--  Mantenimiento completo  -->
                <Button
                    x:Name="BtnFullMaintenance"
                    Grid.Row="6"
                    Click="BtnFullMaintenance_Click"
                    Content="🛠  Mantenimiento completo del sistema"
                    Style="{StaticResource BtnFeatured}" />

                <!--  Herramientas  -->
                <TextBlock
                    Grid.Row="8"
                    Style="{StaticResource SectionLabel}"
                    Text="HERRAMIENTAS Y SALIDA" />
                <Grid Grid.Row="9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="BtnAvanzado"
                        Grid.Column="0"
                        Click="BtnAvanzado_Click"
                        Content="⚙  Herramientas avanzadas"
                        Style="{StaticResource BtnNeutral}" />
                    <Button
                        Grid.Column="2"
                        Click="BtnCerrar_Click"
                        Content="✕  Salir de Mentum"
                        Style="{StaticResource BtnRed}" />
                </Grid>

                <Rectangle
                    Grid.Row="11"
                    Height="1"
                    Fill="#1E2130" />

                <!--  Log  -->
                <TextBlock
                    Grid.Row="13"
                    Margin="0,0,0,6"
                    FontSize="10"
                    FontWeight="SemiBold"
                    Foreground="#4B5563"
                    Text="REGISTRO DE ACCIONES" />
                <Border
                    Grid.Row="14"
                    Background="#080A0F"
                    BorderBrush="#1E2130"
                    BorderThickness="1"
                    CornerRadius="8">
                    <RichTextBox
                        x:Name="LogBox"
                        Padding="12,8"
                        Background="Transparent"
                        BorderThickness="0"
                        FontFamily="Consolas"
                        FontSize="11"
                        Foreground="#4ADE80"
                        IsReadOnly="True"
                        VerticalScrollBarVisibility="Auto" />
                </Border>

                <!--  Progreso  -->
                <TextBlock
                    Grid.Row="16"
                    Margin="0,0,0,6"
                    FontSize="10"
                    FontWeight="SemiBold"
                    Foreground="#4B5563"
                    Text="PROGRESO" />
                <Border
                    Grid.Row="17"
                    Height="8"
                    Background="#0D0F18"
                    BorderBrush="#1E2130"
                    BorderThickness="1"
                    CornerRadius="5">
                    <ProgressBar
                        x:Name="ProgressBar"
                        Height="8"
                        Background="Transparent"
                        BorderThickness="0"
                        Maximum="100"
                        Minimum="0">
                        <ProgressBar.Template>
                            <ControlTemplate TargetType="ProgressBar">
                                <Border
                                    Background="#0D0F18"
                                    BorderThickness="0"
                                    CornerRadius="5">
                                    <Border x:Name="PART_Track" CornerRadius="5">
                                        <Grid>
                                            <Rectangle
                                                x:Name="PART_Indicator"
                                                HorizontalAlignment="Left"
                                                RadiusX="5"
                                                RadiusY="5">
                                                <Rectangle.Fill>
                                                    <SolidColorBrush Color="#22C55E" />
                                                </Rectangle.Fill>
                                            </Rectangle>
                                        </Grid>
                                    </Border>
                                </Border>
                            </ControlTemplate>
                        </ProgressBar.Template>
                    </ProgressBar>
                </Border>

                <!--  Firma  -->
                <Border
                    Grid.Row="19"
                    Padding="14,10"
                    Background="#0A0C12"
                    BorderBrush="#1E2130"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="11"
                            Foreground="#6B7280"
                            Text="🖥  MaRin Raizio · Hecho con código y corazón" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Border
                                Margin="0,0,8,0"
                                Padding="10,5"
                                Background="#1A0A2E"
                                BorderBrush="#6D28D9"
                                BorderThickness="1"
                                CornerRadius="6">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#A78BFA">
                                    ▶<Hyperlink
                                        FontWeight="SemiBold"
                                        Foreground="#C4B5FD"
                                        NavigateUri="https://www.tiktok.com/@MaRin_Raizio"
                                        RequestNavigate="Hyperlink_RequestNavigate">
                                        @MaRin_Raizio
                                    </Hyperlink>
                                </TextBlock>
                            </Border>
                            <Border
                                Padding="10,5"
                                Background="#1A1208"
                                BorderBrush="#92400E"
                                BorderThickness="1"
                                CornerRadius="6">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#FCD34D">
                                    ☕<Hyperlink
                                        FontWeight="SemiBold"
                                        Foreground="#FDE68A"
                                        NavigateUri="https://ko-fi.com/marin_raizio"
                                        RequestNavigate="Hyperlink_RequestNavigate">
                                        ko-fi.com/marin_raizio
                                    </Hyperlink>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>
        </Grid>
    </Border>
</Window>
