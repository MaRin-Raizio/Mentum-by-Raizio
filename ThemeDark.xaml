<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Fondos -->
    <SolidColorBrush x:Key="ThemeBgPrimary"    Color="#0F1117"/>
    <SolidColorBrush x:Key="ThemeBgSurface"    Color="#0A0C12"/>
    <SolidColorBrush x:Key="ThemeBgCard"       Color="#080A0F"/>
    <SolidColorBrush x:Key="ThemeBgTitleBar"   Color="#0D2318"/>
    <SolidColorBrush x:Key="ThemeBorder"       Color="#166534"/>
    <SolidColorBrush x:Key="ThemeBorderSubtle" Color="#1E2130"/>
    <SolidColorBrush x:Key="ThemeBorderOuter"  Color="#252836"/>

    <!-- Texto -->
    <SolidColorBrush x:Key="ThemeTextPrimary"  Color="#CBD5E1"/>
    <SolidColorBrush x:Key="ThemeTextMuted"    Color="#4B5563"/>
    <SolidColorBrush x:Key="ThemeTextDim"      Color="#374151"/>
    <SolidColorBrush x:Key="ThemeTextAccent"   Color="#86EFAC"/>
    <SolidColorBrush x:Key="ThemeTextSubtitle" Color="#4B5563"/>

    <!-- Log -->
    <SolidColorBrush x:Key="ThemeLogBg"        Color="#080A0F"/>
    <SolidColorBrush x:Key="ThemeLogFg"        Color="#4ADE80"/>

    <!-- ScrollBar -->
    <SolidColorBrush x:Key="ThemeScrollBg"     Color="#0D0F18"/>
    <SolidColorBrush x:Key="ThemeScrollThumb"  Color="#2A2D3A"/>
    <SolidColorBrush x:Key="ThemeScrollHover"  Color="#4B5563"/>

    <!-- Separadores -->
    <SolidColorBrush x:Key="ThemeSeparator"    Color="#166534"/>

    <!-- Badge versión -->
    <SolidColorBrush x:Key="ThemeBadgeBg"      Color="#16301E"/>
    <SolidColorBrush x:Key="ThemeBadgeFg"      Color="#4ADE80"/>
    <SolidColorBrush x:Key="ThemeBadgeBorder"  Color="#166534"/>

</ResourceDictionary>
