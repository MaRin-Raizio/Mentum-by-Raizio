<Window
    x:Class="MentumLauncher.VentanaAvanzada"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MentumLauncher"
    Title="Opciones avanzadas"
    Width="760"
    Height="640"
    MinHeight="560"
    AllowsTransparency="False"
    Background="#0F1117"
    FontFamily="Segoe UI"
    ResizeMode="CanMinimize"
    WindowStyle="None">

    <Window.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="BaseBtn" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.80" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.60" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="BtnGreen"
            BasedOn="{StaticResource BaseBtn}"
            TargetType="Button">
            <Setter Property="Background" Value="#0D2318" />
            <Setter Property="BorderBrush" Value="#166534" />
            <Setter Property="Foreground" Value="#86EFAC" />
        </Style>
        <Style
            x:Key="BtnRed"
            BasedOn="{StaticResource BaseBtn}"
            TargetType="Button">
            <Setter Property="Background" Value="#200F0F" />
            <Setter Property="BorderBrush" Value="#7F1D1D" />
            <Setter Property="Foreground" Value="#FCA5A5" />
        </Style>

        <Style x:Key="TitleBtn" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E1530" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="TitleBtnClose"
            BasedOn="{StaticResource TitleBtn}"
            TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#200F0F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Buscador  -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Background" Value="#080A0F" />
            <Setter Property="Foreground" Value="#D1D5DB" />
            <Setter Property="CaretBrush" Value="#A78BFA" />
            <Setter Property="BorderBrush" Value="#1E2130" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Lista con soporte de encabezados de sección  -->
        <Style x:Key="DarkListBox" TargetType="ListBox">
            <Setter Property="Background" Value="#080A0F" />
            <Setter Property="BorderBrush" Value="#1E2130" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate DataType="{x:Type local:CommandEntry}">
                        <Grid>
                            <!--  Encabezado de sección  -->
                            <TextBlock
                                Margin="4,10,4,4"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="#4B5563"
                                Text="{Binding Category}"
                                Visibility="{Binding IsHeader, Converter={StaticResource BoolToVis}}" />
                            <!--  Fila de comando  -->
                            <StackPanel Visibility="{Binding IsCommand, Converter={StaticResource BoolToVis}}">
                                <TextBlock FontWeight="SemiBold" Text="{Binding Command}" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontSize="10"
                                    Foreground="#6B7280"
                                    Text="{Binding Description}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,7" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border
                                        x:Name="itemBd"
                                        Margin="0,1"
                                        Padding="{TemplateBinding Padding}"
                                        Background="Transparent"
                                        CornerRadius="5">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="itemBd" Property="Background" Value="#1C1F2B" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="itemBd" Property="Background" Value="#1E1530" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                <Setter Property="IsHitTestVisible" Value="False" />
                                <Setter Property="Focusable" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border BorderBrush="#6D28D9" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  ══ BARRA DE TÍTULO ══  -->
            <Grid
                Grid.Row="0"
                Background="#1A0A2E"
                MouseDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Border
                        Width="36"
                        Height="36"
                        Margin="0,0,12,0"
                        Background="#1E1530"
                        BorderBrush="#A78BFA"
                        BorderThickness="1"
                        CornerRadius="8">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="18"
                            Foreground="#A78BFA"
                            Text="⚙" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#C4B5FD"
                            LineHeight="16"
                            Text="Herramientas avanzadas" />
                        <TextBlock
                            FontFamily="Consolas"
                            FontSize="10"
                            Foreground="#4B5563"
                            LineHeight="14"
                            Text="modo avanzado · v2.4.0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Click="BtnMinimize_Click"
                        Content="—"
                        FontFamily="Consolas"
                        Foreground="#A78BFA"
                        Style="{StaticResource TitleBtn}" />
                    <Button
                        Click="BtnCerrar_Click"
                        Content="✕"
                        FontFamily="Consolas"
                        Foreground="#FCA5A5"
                        Style="{StaticResource TitleBtnClose}" />
                </StackPanel>
            </Grid>

            <Rectangle
                Grid.Row="1"
                Height="1"
                Fill="#6D28D9" />

            <!--  ══ CONTENIDO ══  -->
            <Grid Grid.Row="2" Margin="22,16,22,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="#A78BFA"
                        Text="Herramientas avanzadas de Mentum" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="11"
                        Foreground="#4B5563"
                        Text="Busca, selecciona y ejecuta cualquier comando directamente sobre el sistema." />
                </StackPanel>

                <Grid Grid.Row="2">
                    <TextBox
                        x:Name="TxtBuscar"
                        Style="{StaticResource SearchBox}"
                        TextChanged="TxtBuscar_TextChanged" />
                    <TextBlock
                        x:Name="TxtBuscarPlaceholder"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="12"
                        Foreground="#4B5563"
                        IsHitTestVisible="False"
                        Text="🔍  Buscar comando..." />
                </Grid>

                <ListBox
                    x:Name="ListaComandos"
                    Grid.Row="4"
                    SelectionChanged="ListaComandos_SelectionChanged"
                    Style="{StaticResource DarkListBox}" />

                <Button
                    x:Name="BtnEjecutar"
                    Grid.Row="6"
                    Click="BtnEjecutar_Click"
                    Content="▶  Ejecutar comando seleccionado"
                    IsEnabled="False"
                    Style="{StaticResource BtnGreen}" />
                <Button
                    Grid.Row="8"
                    Click="BtnCerrar_Click"
                    Content="← Regresar al menú principal"
                    Style="{StaticResource BtnRed}" />
            </Grid>
        </Grid>
    </Border>
</Window>
