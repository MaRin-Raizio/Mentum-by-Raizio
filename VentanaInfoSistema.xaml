<Window
    x:Class="MentumLauncher.VentanaInfoSistema"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Información del Sistema"
    Width="860"
    Height="660"
    MinHeight="620"
    AllowsTransparency="False"
    Background="#0F1117"
    FontFamily="Segoe UI"
    ResizeMode="CanMinimize"
    WindowStyle="None">

    <Window.Resources>

        <Style x:Key="BaseBtn" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.80" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.60" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="BtnGreen"
            BasedOn="{StaticResource BaseBtn}"
            TargetType="Button">
            <Setter Property="Background" Value="#0D2318" />
            <Setter Property="BorderBrush" Value="#166534" />
            <Setter Property="Foreground" Value="#86EFAC" />
        </Style>

        <Style x:Key="TitleBtn" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0D2318" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="TitleBtnClose"
            BasedOn="{StaticResource TitleBtn}"
            TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#200F0F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProgressGreen" TargetType="ProgressBar">
            <Setter Property="Height" Value="10" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border
                            Background="#0D0F18"
                            BorderThickness="0"
                            CornerRadius="5">
                            <Border x:Name="PART_Track" CornerRadius="5">
                                <Grid>
                                    <Rectangle
                                        x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        RadiusX="5"
                                        RadiusY="5">
                                        <Rectangle.Fill>
                                            <SolidColorBrush Color="#22C55E" />
                                        </Rectangle.Fill>
                                    </Rectangle>
                                </Grid>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProgressBlue" TargetType="ProgressBar">
            <Setter Property="Height" Value="10" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border
                            Background="#0D0F18"
                            BorderThickness="0"
                            CornerRadius="5">
                            <Border x:Name="PART_Track" CornerRadius="5">
                                <Grid>
                                    <Rectangle
                                        x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        RadiusX="5"
                                        RadiusY="5">
                                        <Rectangle.Fill>
                                            <SolidColorBrush Color="#3B82F6" />
                                        </Rectangle.Fill>
                                    </Rectangle>
                                </Grid>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkListBox" TargetType="ListBox">
            <Setter Property="Background" Value="#080A0F" />
            <Setter Property="BorderBrush" Value="#1E2130" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,6" />
                        <Setter Property="FontFamily" Value="Consolas" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border
                                        x:Name="itemBd"
                                        Margin="0,1"
                                        Padding="{TemplateBinding Padding}"
                                        Background="Transparent"
                                        CornerRadius="5">
                                        <TextBlock
                                            x:Name="txt"
                                            Foreground="#9CA3AF"
                                            Text="{TemplateBinding Content}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="itemBd" Property="Background" Value="#1C1F2B" />
                                            <Setter TargetName="txt" Property="Foreground" Value="#D1D5DB" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="itemBd" Property="Background" Value="#0D2318" />
                                            <Setter TargetName="txt" Property="Foreground" Value="#86EFAC" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border BorderBrush="#1E3A5F" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  ══ BARRA DE TÍTULO (opción 2: fondo azul oscuro) ══  -->
            <Grid
                Grid.Row="0"
                Background="#0D1929"
                MouseDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Border
                        Width="36"
                        Height="36"
                        Margin="0,0,12,0"
                        Background="#0D1929"
                        BorderBrush="#93C5FD"
                        BorderThickness="1"
                        CornerRadius="8">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="18"
                            Text="💻" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#93C5FD"
                            LineHeight="16"
                            Text="Información del sistema" />
                        <TextBlock
                            FontFamily="Consolas"
                            FontSize="10"
                            Foreground="#4B5563"
                            LineHeight="14"
                            Text="datos en vivo · actualización cada 1s" />
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Click="BtnMinimize_Click"
                        Content="—"
                        FontFamily="Consolas"
                        Foreground="#93C5FD"
                        Style="{StaticResource TitleBtn}" />
                    <Button
                        Click="BtnRegresar_Click"
                        Content="✕"
                        FontFamily="Consolas"
                        Foreground="#FCA5A5"
                        Style="{StaticResource TitleBtnClose}" />
                </StackPanel>
            </Grid>

            <Rectangle
                Grid.Row="1"
                Height="1"
                Fill="#1E3A5F" />

            <!--  ══ CONTENIDO ══  -->
            <Grid Grid.Row="2" Margin="22,14,22,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  CPU  -->
                <Border
                    Grid.Row="0"
                    Padding="14,10"
                    Background="#080A0F"
                    BorderBrush="#166534"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="#4B5563"
                                Text="USO DE CPU" />
                            <TextBlock
                                x:Name="CpuLabel"
                                Grid.Column="1"
                                FontFamily="Consolas"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="#4ADE80"
                                Text="0%" />
                        </Grid>
                        <ProgressBar
                            x:Name="CpuBar"
                            Grid.Row="2"
                            Style="{StaticResource ProgressGreen}" />
                    </Grid>
                </Border>

                <!--  RAM  -->
                <Border
                    Grid.Row="2"
                    Padding="14,10"
                    Background="#080A0F"
                    BorderBrush="#1E3A5F"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="#4B5563"
                                Text="USO DE RAM" />
                            <TextBlock
                                x:Name="RamLabel"
                                Grid.Column="1"
                                FontFamily="Consolas"
                                FontSize="11"
                                Foreground="#93C5FD"
                                Text="0 MB usados / 0 MB totales" />
                        </Grid>
                        <ProgressBar
                            x:Name="RamBar"
                            Grid.Row="2"
                            Style="{StaticResource ProgressBlue}" />
                    </Grid>
                </Border>

                <!--  Discos label  -->
                <TextBlock
                    Grid.Row="4"
                    FontSize="10"
                    FontWeight="SemiBold"
                    Foreground="#4B5563"
                    Text="ESPACIO EN DISCOS" />
                <ListBox
                    x:Name="DiskList"
                    Grid.Row="6"
                    Style="{StaticResource DarkListBox}" />

                <!--  Detalles label  -->
                <TextBlock
                    Grid.Row="8"
                    FontSize="10"
                    FontWeight="SemiBold"
                    Foreground="#4B5563"
                    Text="DETALLES DEL SISTEMA" />
                <ListBox
                    x:Name="SystemDetailsList"
                    Grid.Row="9"
                    Style="{StaticResource DarkListBox}" />

                <!--  Botón  -->
                <Button
                    Grid.Row="11"
                    Width="240"
                    HorizontalAlignment="Right"
                    Click="BtnRegresar_Click"
                    Content="← Regresar al menú principal"
                    Style="{StaticResource BtnGreen}" />
            </Grid>
        </Grid>
    </Border>
</Window>
