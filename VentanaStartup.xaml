<Window
    x:Class="MentumLauncher.VentanaStartup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Programas de inicio"
    Width="700" Height="560" MinHeight="480"
    Background="#0F1117"
    FontFamily="Segoe UI"
    WindowStyle="None"
    AllowsTransparency="False"
    ResizeMode="CanMinimize">

    <Window.Resources>

        <Style x:Key="BaseBtn" TargetType="Button">
            <Setter Property="Height"          Value="40"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.80"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.60"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnAmber" BasedOn="{StaticResource BaseBtn}" TargetType="Button">
            <Setter Property="Background"  Value="#1C1408"/>
            <Setter Property="BorderBrush" Value="#78350F"/>
            <Setter Property="Foreground"  Value="#FCD34D"/>
        </Style>

        <Style x:Key="BtnGreen" BasedOn="{StaticResource BaseBtn}" TargetType="Button">
            <Setter Property="Background"  Value="#0D2318"/>
            <Setter Property="BorderBrush" Value="#166534"/>
            <Setter Property="Foreground"  Value="#86EFAC"/>
        </Style>

        <Style x:Key="BtnRed" BasedOn="{StaticResource BaseBtn}" TargetType="Button">
            <Setter Property="Background"  Value="#200F0F"/>
            <Setter Property="BorderBrush" Value="#7F1D1D"/>
            <Setter Property="Foreground"  Value="#FCA5A5"/>
        </Style>

        <Style x:Key="TitleBtn" TargetType="Button">
            <Setter Property="Width"           Value="36"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1C1408"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBtnClose" BasedOn="{StaticResource TitleBtn}" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#200F0F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkListBox" TargetType="ListBox">
            <Setter Property="Background"      Value="#080A0F"/>
            <Setter Property="BorderBrush"     Value="#1E2130"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily"      Value="Consolas"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Foreground"      Value="#9CA3AF"/>
            <Setter Property="Padding"         Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding"    Value="10,8"/>
                        <Setter Property="FontFamily" Value="Consolas"/>
                        <Setter Property="FontSize"   Value="12"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="itemBd" Background="Transparent"
                                            CornerRadius="5" Padding="{TemplateBinding Padding}" Margin="0,1">
                                        <TextBlock x:Name="txt" Text="{TemplateBinding Content}" Foreground="#9CA3AF"
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="itemBd" Property="Background" Value="#1C1F2B"/>
                                            <Setter TargetName="txt"    Property="Foreground"  Value="#D1D5DB"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="itemBd" Property="Background" Value="#1C1408"/>
                                            <Setter TargetName="txt"    Property="Foreground"  Value="#FCD34D"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border BorderBrush="#78350F" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ══ BARRA DE TÍTULO ══ -->
            <Grid Grid.Row="0" Background="#1C1408" MouseDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border Width="36" Height="36"
                            Background="#1C1408" BorderBrush="#FCD34D"
                            BorderThickness="1" CornerRadius="8" Margin="0,0,12,0">
                        <TextBlock Text="🚀" FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="14" FontWeight="SemiBold"
                                   Foreground="#FCD34D" LineHeight="16"
                                   Text="Programas de inicio"/>
                        <TextBlock FontFamily="Consolas" FontSize="10"
                                   Foreground="#4B5563" LineHeight="14"
                                   Text="habilita o deshabilita lo que arranca con Windows"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button Style="{StaticResource TitleBtn}"
                            Click="BtnMinimize_Click"
                            Foreground="#FCD34D" Content="—" FontFamily="Consolas"/>
                    <Button Style="{StaticResource TitleBtnClose}"
                            Click="BtnClose_Click"
                            Foreground="#FCA5A5" Content="✕" FontFamily="Consolas"/>
                </StackPanel>
            </Grid>

            <Rectangle Grid.Row="1" Height="1" Fill="#78350F"/>

            <!-- ══ CONTENIDO ══ -->
            <Grid Grid.Row="2" Margin="22,16,22,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock FontSize="17" FontWeight="Bold"
                               Foreground="#FCD34D"
                               Text="Administrador de inicio de Windows"/>
                    <TextBlock FontSize="11" Foreground="#4B5563" Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Text="Selecciona un programa y presiona Deshabilitar o Habilitar. Los cambios se aplican de inmediato y son reversibles."/>
                </StackPanel>

                <TextBlock Grid.Row="2" FontSize="10" FontWeight="SemiBold"
                           Foreground="#4B5563" Text="PROGRAMAS ENCONTRADOS"/>

                <ListBox Grid.Row="4" x:Name="StartupList" Style="{StaticResource DarkListBox}"/>

                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnToggle" Grid.Column="0"
                            Style="{StaticResource BtnAmber}"
                            Click="BtnToggle_Click"
                            Content="⏻  Deshabilitar seleccionado"/>
                    <Button x:Name="BtnRefresh" Grid.Column="2"
                            Style="{StaticResource BtnGreen}"
                            Click="BtnRefresh_Click"
                            Content="🔄  Actualizar lista"/>
                </Grid>

                <Button Grid.Row="8"
                        Style="{StaticResource BtnRed}"
                        Click="BtnClose_Click"
                        Content="← Regresar al menú principal"/>
            </Grid>
        </Grid>
    </Border>
</Window>
